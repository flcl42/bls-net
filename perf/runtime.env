# Change only this file on an experiment branch. Values use shell quoting.
RUNTIME_REPO=flcl42/runtime
RUNTIME_REF=8a918efed98f5744e387e79223363898a43ea883
# Space-separated paths relative to this repository, applied in order with git apply.
RUNTIME_PATCHES=''
BENCH_FILTER='Fp multiply|Fp square|Fp2 multiply|Fp2 square|Fr mul+add|Fp mul+add|Fp inverse|Fp12 multiply|Pairing check 2|G1 multiply|G2 multiply|G1 MSM 128|G2 MSM 128|map G1|map G2'
BENCH_REPETITIONS=3
# macOS is optional; Linux always runs. Windows is not enabled.
RUN_MACOS=false
