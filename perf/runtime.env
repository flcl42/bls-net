# Change only this file on an experiment branch. Values use shell quoting.
RUNTIME_REPO=flcl42/runtime
RUNTIME_REF=00403488cf87511ed9bf52c824b7b53100c145c3
# Space-separated paths relative to this repository, applied in order with git apply.
RUNTIME_PATCHES=''
BENCH_FILTER='Fp multiply|Fp square|Fp2 multiply|Fp2 square|Fr mul+add|Fp mul+add|Fp inverse|Fp12 multiply|Pairing check 2|G1 multiply|G2 multiply|G1 MSM 128|G2 MSM 128|map G1|map G2|Fp12 square|ReduceWide|MultiplyWide|Cyclotomic square|Miller|Final exponentiation|Pairing check 1|Pairing check 8|G1 MSM 1|G2 MSM 1|G1 add|G2 add|G1 subgroup|G2 subgroup|Fp2 add|Fp2 subtract|Fp2 mul by|Fp12 sparse|Fp12 two sparse'
BENCH_REPETITIONS=3
# macOS is optional; Linux always runs. Windows is not enabled.
RUN_MACOS=true
